PROJECT_NAME="Xploria Developer API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Generate with: openssl rand -hex 32
SECRET_KEY="replace_me_with_a_secure_random_hex_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL connection string for asyncpg
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/xploria"

# Google OAuth2
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Business logic configs
FREE_PROJECT_QUOTA=100
