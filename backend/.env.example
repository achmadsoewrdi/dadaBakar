PROJECT_NAME="Xploria Developer API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database Settings
# Format Asyncpg: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/xploria"

# Security JWT
SECRET_KEY="xploria_dev_secret_key_change_in_production_key_12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Groq AI Settings & Rate Limiter
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_MAX_REQUESTS_PER_MINUTE=20
GROQ_MAX_REQUESTS_PER_DAY=1000

